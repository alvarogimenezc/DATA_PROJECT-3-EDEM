# ── Base de datos PostgreSQL ──────────────────────────────────
# En GCP: usar Cloud SQL. DB_HOST = IP privada o socket Unix del proxy
# Ej: DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE  (Cloud SQL Auth Proxy)
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=tienda
DB_PORT=5432

# ── Autenticación JWT ─────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# En GCP: almacenar en Secret Manager y referenciar como variable de entorno
SECRET_KEY=CHANGE_ME

# ── CORS ─────────────────────────────────────────────────────
# En producción: URL exacta del frontend (Cloud Run, Firebase Hosting, etc.)
# Múltiples orígenes separados por coma: https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000
